[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_q5gh7"]
size = Vector2(1540, 1120)
expression = "vec2 px = uv * rect_size;

float left = px.x;
float right = rect_size.x - px.x;
float top = px.y;
float bottom = rect_size.y - px.y;

float edge_dist = min(min(left, right), min(top, bottom));

float outer = step(inset, edge_dist);
float inner = 1.0 - step(inset + thickness, edge_dist);
float border_mask = outer * inner;

float near_left = step(left, right) * step(left, top) * step(left, bottom);
float near_right = step(right, left) * step(right, top) * step(right, bottom);
float near_top = step(top, left) * step(top, right) * step(top, bottom);

float perimeter_pos = 0.0;

if (near_top > 0.5) {
	perimeter_pos = px.x;
} else if (near_right > 0.5) {
	perimeter_pos = rect_size.x + px.y;
} else if (near_left > 0.5) {
	perimeter_pos = rect_size.x + rect_size.y + rect_size.x + (rect_size.y - px.y);
} else {
	perimeter_pos = rect_size.x + rect_size.y + (rect_size.x - px.x);
}

float dash_cycle = dash_length + gap_length;
float dash_position = mod(perimeter_pos - time * speed, dash_cycle);
float dash = 1.0 - step(dash_length, dash_position);

float pulse = 1.0 + sin(time * 5.0) * pulse_strength;

out_rgb = border_color.rgb * pulse;
out_alpha = border_color.a * border_mask * dash;"

